<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/black">
<androidx.viewpager2.widget.ViewPager2 android:id="@+id/reelPager" android:layout_width="match_parent" android:layout_height="match_parent"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:gravity="center_vertical" android:paddingStart="18dp" android:paddingEnd="18dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="InstaLy" android:textColor="@color/white" android:textSize="22sp" android:textStyle="bold" android:fontFamily="cursive"/>
<Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
<ImageButton android:layout_width="44dp" android:layout_height="44dp" android:background="@android:color/transparent" android:contentDescription="Camera" android:src="@android:drawable/ic_menu_camera" android:tint="@color/white"/>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="68dp" android:layout_gravity="bottom" android:background="#CC000000" android:gravity="center" android:orientation="horizontal">
<TextView android:id="@+id/navHome" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="⌂" android:textColor="@color/white" android:textSize="25sp"/>
<TextView android:id="@+id/navSearch" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="⌕" android:textColor="@color/white" android:textSize="28sp"/>
<TextView android:id="@+id/navCreate" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="＋" android:textColor="@color/white" android:textSize="27sp"/>
<TextView android:id="@+id/navReels" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="▣" android:textColor="@color/white" android:textSize="22sp"/>
<TextView android:id="@+id/navProfile" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="●" android:textColor="@color/white" android:textSize="20sp"/>
</LinearLayout></FrameLayout>